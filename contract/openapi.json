        "required": [
          "sku",
          "name"
        ],
        "title": "ItemCreate",
        "type": "object"
      },
      "ItemUpdate": {
        "properties": {
          "name": {
            "maxLength": 200,
            "minLength": 1,
            "title": "Name",
            "type": "string"
          },
          "quantity": {
            "minimum": 0.0,
            "title": "Quantity",
            "type": "integer"
