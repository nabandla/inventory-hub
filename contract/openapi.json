        "properties": {
          "name": {
            "maxLength": 200,
            "minLength": 1,
            "title": "Name",
            "type": "string"
          },
          "quantity": {
            "default": 0,
            "minimum": 0.0,
            "title": "Quantity",
            "type": "integer"
          },
